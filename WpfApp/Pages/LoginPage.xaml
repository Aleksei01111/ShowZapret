<Page x:Class="WpfApp.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp.Pages"
      xmlns:uControls="clr-namespace:WpfApp.UserControl"
      mc:Ignorable="d"
      Title="LoginPage">
    <StackPanel>
        <TextBlock Text="Вход" Style="{StaticResource Head1}" HorizontalAlignment="Center"/>

        <uControls:TextBoxWithPlaceholder Placeholder="Логин"
                                          Text="{Binding Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <uControls:TextBoxWithPlaceholder Placeholder="Пароль"
                                          Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Button Content="Войти" Style="{StaticResource Button1}" Click="Login_OnClick" Margin="0 20 0 0"/>
    </StackPanel>
</Page>