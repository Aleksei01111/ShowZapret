<Window x:Class="WpfApp.Window.EditablePopUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfApp.Window"
        mc:Ignorable="d"
        Title="EditablePopUp" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        
        <TextBox Grid.Row="0" 
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Style="{StaticResource Text}"
                 AcceptsReturn="True" AcceptsTab="True"/>
        
        <Button Grid.Row="1" Content="Готово" 
                Style="{StaticResource SmallButton}"
                Click="EndEdit_OnClick"/>
    </Grid>
</Window>
