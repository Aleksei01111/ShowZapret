<Page x:Class="WpfApp.Pages.MainWindow.RKNEmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp.Pages.MainWindow"
      xmlns:uControls="clr-namespace:WpfApp.UserControl"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:RKNEmployeePage, IsDesignTimeCreatable=True}"
      Title="RKNEmployeePage" d:DesignHeight="450" d:DesignWidth="800">
    <Page.Resources>
        <local:SelectedElementToIsEnableConverter x:Key="SelectedVisibility"/>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.22*"/>
        </Grid.RowDefinitions>
        
        <ListBox Grid.Column="0" ItemsSource="{Binding Rules}"
                 SelectedItem="{Binding SelectedRule}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NameOfRule}" 
                                   Style="{StaticResource RulePlaceholderText}" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding UserCreator.Login}" 
                                   Style="{StaticResource RulePlaceholderText}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Grid.Column="0" Grid.Row="1">
            <Button Content="Добавить" 
                    Style="{StaticResource Button1}" Click="AddNewRule_OnClick"/>
            <Button Content="Обновить"
                    Style="{StaticResource Button2}"
                    Click="RefreshRules_OnClick"/>
        </StackPanel>
        
        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Width="3" HorizontalAlignment="Stretch"/>
        
        <ScrollViewer Grid.Column="2" Grid.Row="0" 
                      IsEnabled="{Binding SelectedRule,
                       Converter={StaticResource SelectedVisibility}}">
            <StackPanel>
                <uControls:TextBoxWithPlaceholder 
                    IsReadOnly="True" Placeholder="Id" 
                    Text="{Binding SelectedRule.Id}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Создатель правила"
                    IsReadOnly="True"
                    Text="{Binding SelectedRule.UserCreator.Login}"/>
                <uControls:TextBoxWithPlaceholder 
                    Placeholder="Имя правила"
                    Text="{Binding SelectedRule.NameOfRule}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Слово триггер"
                    Text="{Binding SelectedRule.TriggerWord}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Порог срабатывания слова триггера"
                    Text="{Binding SelectedRule.TriggerWordMatchThreshold}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Наказание в свободе (мес)"
                    Text="{Binding SelectedRule.FreedomPunishInMonth}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Штраф (рубли)"
                    Text="{Binding SelectedRule.MoneyPunishmentInRubles}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Условие: слово после"
                    Text="{Binding SelectedRule.RightWordNext}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Порог срабатывания для слова после"
                    Text="{Binding SelectedRule.ThresholdForRightWordNext}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Условие: слово до"
                    Text="{Binding SelectedRule.RightWordPrevious}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Порог срабатывания для слова до"
                    Text="{Binding SelectedRule.ThresholdForRightWordPrevious}"/>
            </StackPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="1" Grid.Column="2"
                    IsEnabled="{Binding SelectedRule,
                     Converter={StaticResource SelectedVisibility}}">
            <Button Content="Сохранить"
                    Style="{StaticResource Button1}"
                    Click="SaveSelectedRule_OnClick"/>
            <Button Content="Удалить"
                    Style="{StaticResource Button2}"
                    Click="DeleteSelectedRule_OnClick"/>
        </StackPanel>
    </Grid>
</Page>