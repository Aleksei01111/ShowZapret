<Window x:Class="WpfApp.Window.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfApp.Window"
        xmlns:uControls="clr-namespace:WpfApp.UserControl"
        mc:Ignorable="d"
        Title="LoginWindow" Height="500" Width="400"
        Closing="LoginWindow_OnClosing">
    <StackPanel Margin="10">
        <uControls:TextBoxWithPlaceholder Placeholder="Логин" Margin="0 0 0 10"/>
        <uControls:TextBoxWithPlaceholder Placeholder="Пароль"/>
        
        <Button Content="Зарегистрироваться" 
                Style="{StaticResource Button1}"
                Margin="10 40 0 0" Click="Register_OnClick"/>
    </StackPanel>
</Window>
