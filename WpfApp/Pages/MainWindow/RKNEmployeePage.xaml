<Page x:Class="WpfApp.Pages.MainWindow.RKNEmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp.Pages.MainWindow"
      xmlns:converters="clr-namespace:WpfApp.Converters"
      xmlns:uControls="clr-namespace:GeneralElementsZapretUI.UserControls;assembly=GeneralElementsZapretUI"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:RKNEmployeePage, IsDesignTimeCreatable=True}"
      Title="RKNEmployeePage" d:DesignHeight="450" d:DesignWidth="800">
    <Page.Resources>
        <converters:SelectedElementToIsEnableConverter x:Key="SelectedVisibility"/>
        <converters:WordAnalysisVerdictToBrushConverter x:Key="CleanWordAnalysisVerdict"/>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="0.44*"/>
        </Grid.RowDefinitions>
        
        <ListBox Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" ItemsSource="{Binding Rules}"
                 SelectedItem="{Binding SelectedRule}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NameOfRule}" 
                                   Style="{StaticResource RulePlaceholderText}" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding UserCreator.Login}" 
                                   Style="{StaticResource RulePlaceholderText}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Grid.Column="0" Grid.Row="3">
            <Button Content="Добавить" 
                    Style="{StaticResource Button1}" Click="AddNewRule_OnClick"/>
            <Button Content="Обновить"
                    Style="{StaticResource Button2}"
                    Click="RefreshRules_OnClick"/>
        </StackPanel>
        
        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Width="3" HorizontalAlignment="Stretch"/>
        
        <ScrollViewer Grid.Column="2" Grid.Row="0" 
                      IsEnabled="{Binding SelectedRule,
                       Converter={StaticResource SelectedVisibility}}">
            <StackPanel>
                <uControls:TextBoxWithPlaceholder 
                    IsReadOnly="True" Placeholder="Id" 
                    Text="{Binding SelectedRule.Id}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Создатель правила"
                    IsReadOnly="True"
                    Text="{Binding SelectedRule.UserCreator.Login}"/>
                <uControls:TextBoxWithPlaceholder 
                    Placeholder="Имя правила"
                    Text="{Binding SelectedRule.NameOfRule}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Слово триггер"
                    Text="{Binding SelectedRule.TriggerWord}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Порог срабатывания слова триггера"
                    Text="{Binding SelectedRule.TriggerWordMatchThreshold}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Наказание в свободе (мес)"
                    Text="{Binding SelectedRule.FreedomPunishInMonth}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Штраф (рубли)"
                    Text="{Binding SelectedRule.MoneyPunishmentInRubles}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Условие: слово после"
                    Text="{Binding SelectedRule.RightWordNext}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Порог срабатывания для слова после"
                    Text="{Binding SelectedRule.ThresholdForRightWordNext}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Условие: слово до"
                    Text="{Binding SelectedRule.RightWordPrevious}"/>
                <uControls:TextBoxWithPlaceholder
                    Placeholder="Порог срабатывания для слова до"
                    Text="{Binding SelectedRule.ThresholdForRightWordPrevious}"/>
            </StackPanel>
        </ScrollViewer>
        
        <GridSplitter Grid.Column="2" Grid.Row="1" Height="3" HorizontalAlignment="Stretch"/>
        
        <Grid Grid.Column="2" Grid.Row="2" 
              IsEnabled="{Binding SelectedRule, 
              Converter={StaticResource SelectedVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <uControls:MultilineTextWithPlaceholder Grid.Row="0" 
                Placeholder="Текст" 
                Text="{Binding InputTestText}"/>
            
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding WordsAnalysisForTestText}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Value}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Target.Value}" 
                                               Style="{StaticResource Word}"
                                               Background="{Binding Verdict, Converter={StaticResource CleanWordAnalysisVerdict}}"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <Button Grid.Row="2" Content="Проверить" Click="CheckTestInputTextForSelectedRule_OnClick"
                    Style="{StaticResource SmallButton}" HorizontalAlignment="Left"/>
        </Grid>
        
        <StackPanel Grid.Row="3" Grid.Column="2"
                    IsEnabled="{Binding SelectedRule,
                     Converter={StaticResource SelectedVisibility}}">
            <Button Content="Сохранить"
                    Style="{StaticResource Button1}"
                    Click="SaveSelectedRule_OnClick"/>
            <Button Content="Удалить"
                    Style="{StaticResource Button2}"
                    Click="DeleteSelectedRule_OnClick"/>
        </StackPanel>
    </Grid>
</Page>