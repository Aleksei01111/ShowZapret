<Page x:Class="WpfApp.Pages.CreateDonos.FinalStepPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp.Pages.CreateDonos"
      mc:Ignorable="d"
      Title="FinalStepPage" d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Button Grid.Row="0" Content="Завершить"
                Style="{StaticResource Button1}" Click="Done_OnClick"/>
        
        <Image Grid.Row="1" Source="../../Resources/Images/смешной шаман с флагом.jpg" Stretch="Fill" Width="300"/>
    </Grid>
</Page>
