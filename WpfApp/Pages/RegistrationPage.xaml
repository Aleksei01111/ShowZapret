<Page x:Class="WpfApp.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp.Pages"
      xmlns:uControls="clr-namespace:GeneralElementsZapretUI.UserControls;assembly=GeneralElementsZapretUI"
      mc:Ignorable="d"
      Title="RegistrationPage">
    <StackPanel>
        <TextBlock Text="Регистрация" Style="{StaticResource Head1}" HorizontalAlignment="Center"/>

        <uControls:TextBoxWithPlaceholder Placeholder="Логин"
                                          Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
        <uControls:PasswordBoxWithPlaceholder Placeholder="Пароль"
                                          Password="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <uControls:PasswordBoxWithPlaceholder Placeholder="Повтор пароля"
                                              Password="{Binding PasswordRepeat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <uControls:TextBoxWithPlaceholder Placeholder="Адрес"
                                          Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

        <Button Content="Зарегистрироваться" Style="{StaticResource Button1}" Click="RegisterDone_OnClick" Margin="0 20 0 0"/>
    </StackPanel>
</Page>