<Window x:Class="WpfApp.Window.CreateDonosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfApp.Window"
        mc:Ignorable="d"
        Title="CreateDonosWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.4*"/>
        </Grid.RowDefinitions>
        
        <Frame x:Name="StepsFrame"
               NavigationUIVisibility="Hidden"
               HorizontalAlignment="Stretch"
               HorizontalContentAlignment="Stretch"
               VerticalAlignment="Stretch"
               VerticalContentAlignment="Stretch"
               Margin="10"/>
        
        <Image Grid.Row="1" Source="../Resources/Images/флаг россии.gif" Stretch="Fill" Width="300"/>
    </Grid>
</Window>
